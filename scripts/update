#!/usr/bin/env bash
set -euo pipefail

# ──────────────────────────────────────────────────────────────
# sellm — bare-metal update/setup script (Ubuntu 24.04)
# Usage: sudo bash scripts/update [DOMAIN]
#   DOMAIN   optional domain for nginx+SSL (e.g. sellm.nmendez.app)
# ──────────────────────────────────────────────────────────────

DOMAIN="${1:-}"
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
VENV="$REPO_DIR/venv"
APP_USER="${SUDO_USER:-root}"
APP_HOME="$REPO_DIR"

export DEBIAN_FRONTEND=noninteractive

# ── Colors ──
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { echo -e "${GREEN}✓${NC} $1"; }
warn()  { echo -e "${YELLOW}⚠${NC} $1"; }
err()   { echo -e "${RED}✗${NC} $1"; }

# ── Preflight ──
if [[ $EUID -ne 0 ]]; then
    err "This script must be run as root (sudo)."
    exit 1
fi

if ! grep -qi ubuntu /etc/os-release 2>/dev/null; then
    warn "This script is tuned for Ubuntu. Proceed with caution."
fi

cd "$REPO_DIR"

# ──────────────────────────────────────────────────────────────
# 1. System packages
# ──────────────────────────────────────────────────────────────
info "Updating system packages..."
apt-get update -qq

info "Installing system dependencies..."
apt-get install -y -qq \
    python3-pip python3-venv python3-full \
    openjdk-17-jdk \
    nginx \
    wget curl gpg

# ──────────────────────────────────────────────────────────────
# 2. Python virtual environment & dependencies
# ──────────────────────────────────────────────────────────────
if [[ ! -d "$VENV" ]]; then
    info "Creating Python virtual environment..."
    python3 -m venv "$VENV"
fi

info "Installing/updating Python dependencies..."
"$VENV/bin/pip" install --quiet --upgrade pip

# Install torch first (pick version compatible with host Python)
"$VENV/bin/pip" install --quiet "torch>=2.2.0,<2.6.0" 2>/dev/null || \
    "$VENV/bin/pip" install --quiet torch --index-url https://download.pytorch.org/whl/cpu

"$VENV/bin/pip" install --quiet -r "$REPO_DIR/requirements.txt"

# ──────────────────────────────────────────────────────────────
# 3. Neo4j
# ──────────────────────────────────────────────────────────────
if ! command -v neo4j &>/dev/null; then
    info "Installing Neo4j..."
    wget -qO - https://debian.neo4j.com/neotechnology.gpg.key \
        | gpg --dearmor -o /usr/share/keyrings/neo4j.gpg 2>/dev/null
    echo 'deb [signed-by=/usr/share/keyrings/neo4j.gpg] https://debian.neo4j.com stable latest' \
        > /etc/apt/sources.list.d/neo4j.list
    apt-get update -qq
    apt-get install -y -qq neo4j cypher-shell
fi

if ! systemctl is-active --quiet neo4j; then
    info "Setting Neo4j initial password..."
    systemctl stop neo4j 2>/dev/null || true
    sleep 2
    neo4j-admin dbms set-initial-password password 2>/dev/null || true
    systemctl start neo4j
    info "Waiting for Neo4j to be ready..."
    for i in $(seq 1 30); do
        if ss -tlnp | grep -q 7687; then break; fi
        sleep 2
    done
fi

# ──────────────────────────────────────────────────────────────
# 4. Environment file
# ──────────────────────────────────────────────────────────────
if [[ ! -f "$REPO_DIR/app/.env" ]]; then
    info "Creating app/.env from template..."
    cp "$REPO_DIR/.env.example" "$REPO_DIR/app/.env"
    # Set template backend by default (no API key needed)
    sed -i 's/^LLM_BACKEND=.*/LLM_BACKEND=template/' "$REPO_DIR/app/.env"
    sed -i 's/^LLM_MODEL=.*/LLM_MODEL=/' "$REPO_DIR/app/.env"
    info "Edit app/.env to configure LLM, Neo4j password, etc."
fi

# ── Ensure storage dirs ──
mkdir -p "$REPO_DIR/storage"

# ──────────────────────────────────────────────────────────────
# 5. ChromaDB index (if not yet built)
# ──────────────────────────────────────────────────────────────
CHROMA_DIR="${REPO_DIR}/storage/chroma_db_v2"
if [[ ! -f "$CHROMA_DIR/chroma.sqlite3" ]]; then
    info "Building ChromaDB index from Excel data..."
    cd "$REPO_DIR"
    "$VENV/bin/python" -m setup.chroma.init_chroma
fi

# ──────────────────────────────────────────────────────────────
# 6. Systemd service
# ──────────────────────────────────────────────────────────────
SERVICE_FILE="/etc/systemd/system/sellm.service"
if [[ ! -f "$SERVICE_FILE" ]]; then
    info "Creating systemd service..."
    cat > "$SERVICE_FILE" <<SERVICEEOF
[Unit]
Description=sellm FastAPI app
After=network.target neo4j.service

[Service]
Type=simple
User=root
WorkingDirectory=$REPO_DIR
ExecStart=$VENV/bin/uvicorn app.api.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONPATH=$REPO_DIR

[Install]
WantedBy=multi-user.target
SERVICEEOF
    systemctl daemon-reload
    systemctl enable sellm
fi

systemctl restart sellm
info "Waiting for sellm app..."
for i in $(seq 1 30); do
    if ss -tlnp | grep -q 8000; then break; fi
    sleep 2
done

# ──────────────────────────────────────────────────────────────
# 7. nginx reverse proxy (optional — requires domain)
# ──────────────────────────────────────────────────────────────
if [[ -n "$DOMAIN" ]]; then
    # Create basic site config
    NGINX_CONF="/etc/nginx/sites-available/$DOMAIN"
    if [[ ! -f "$NGINX_CONF" ]]; then
        info "Creating nginx config for $DOMAIN..."
        mkdir -p "/var/www/$DOMAIN"
        echo "<h1>$DOMAIN</h1>" > "/var/www/$DOMAIN/index.html"

        cat > "$NGINX_CONF" <<NGINXEOF
server {
    listen 80;
    server_name $DOMAIN;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
NGINXEOF
        ln -sf "$NGINX_CONF" /etc/nginx/sites-enabled/
        rm -f /etc/nginx/sites-enabled/default
    fi

    nginx -t && systemctl reload nginx

    # SSL via certbot (only if not already done)
    if [[ ! -d "/etc/letsencrypt/live/$DOMAIN" ]]; then
        if command -v certbot &>/dev/null || apt-get install -y -qq certbot python3-certbot-nginx; then
            info "Obtaining SSL certificate for $DOMAIN..."
            certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos \
                --email "admin@${DOMAIN#*.}" || \
            warn "Certbot failed — SSL not configured. Run manually: certbot --nginx -d $DOMAIN"
        fi
    fi

    # Reload nginx to pick up SSL config from certbot
    nginx -t && systemctl reload nginx
    info "Site available at https://$DOMAIN"
else
    info "No domain provided. App running on http://localhost:8000"
    info "To add nginx+SSL later: sudo bash scripts/update your.domain.com"
fi

# ──────────────────────────────────────────────────────────────
# 8. Summary
# ──────────────────────────────────────────────────────────────
echo ""
echo " ── sellm setup complete ──"
echo ""
echo "   App:      http://localhost:8000"
if [[ -n "$DOMAIN" ]]; then
    echo "   Public:   https://$DOMAIN"
fi
echo "   Neo4j:    bolt://localhost:7687 (neo4j / password)"
echo "   Logs:     journalctl -u sellm -f"
echo ""
echo "   LLM backend: template (edit app/.env to use Ollama or OpenAI)"
echo "   RAG backend: chromadb (set RAG_BACKEND=neo4j for graph mode)"
echo ""
