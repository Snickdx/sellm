# Requirements Chatbot — environment template (single source of truth)
#
# Local dev:
#   cp app/.env.example app/.env
#
# Docker / EasyPanel: set variables in the panel or compose env — do not commit .env.
#   Use /app paths below (see docs/DEPLOY_EASYPANEL.md).

# --- Paths (local defaults; uncomment Docker block for containers) ---
EXCEL_FILE=data.xlsx
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db_v2
CONVERSATION_DB_URL=sqlite:///./storage/conversations.db
# Docker / EasyPanel:
# EXCEL_FILE=/app/data.xlsx
# CHROMA_PERSIST_DIRECTORY=/app/storage/chroma_db_v2
# CONVERSATION_DB_URL=sqlite:////app/storage/conversations.db
# CONVERSATION_DB_URL=postgresql+psycopg2://USER:PASSWORD@postgres:5432/DATABASE
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# --- RAG ---
# chromadb | neo4j
RAG_BACKEND=chromadb
RAG_TOP_K=5

# Neo4j (neo4j mode, hybrid, or RAG_BACKEND=neo4j)
# Test auth: python -m setup.neo4j.test_connection
# Load graph after auth works: python -m setup.neo4j.load_graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Hybrid chat routing (response_mode=hybrid) — see docs/MCP_NEO4J.md
# NEO4J_MCP_ENABLED=true
# NEO4J_MCP_URL=http://localhost:8100/mcp/
# NEO4J_MCP_NAMESPACE=
HYBRID_ROUTE_MARGIN=0.15
HYBRID_TOP_K=3

# --- LLM ---
# ollama | openai | anthropic | template (default at startup; chat UI can switch per message)
LLM_BACKEND=ollama
LLM_MODEL=llama3.2
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=280
OLLAMA_TOP_P=0.9
# OPENAI_API_BASE=https://api.openai.com/v1
# Extra models in chat dropdown (comma-separated)
# LLM_OPENAI_MODELS=gpt-4o,gpt-4o-mini
# LLM_ANTHROPIC_MODELS=claude-3-5-sonnet-20241022
# OLLAMA_HOST=http://localhost:11434
# LLM_OLLAMA_MODELS=mistral,phi3

# --- Hugging Face Hub (embedding model downloads) ---
# HF_TOKEN=hf_your_token_here

# --- Secrets encryption (user API keys in DB) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEY=

# --- Behavior tweaks (optional feedback loop) ---
TWEAK_MODE_ENABLED=false
BEHAVIOR_TWEAKS_FILE=config/behavior/behavior_tweaks.json

# --- DB pool (PostgreSQL only) ---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
