# Stakeholder Simulator — environment template
#
# Local dev:
#   cp app/.env.example app/.env
#
# The app loads app/.env first, then project-root .env (first file wins per key).
# Docker / EasyPanel: set variables in compose or the panel — do not commit .env.
#   See docs/DEPLOY_EASYPANEL.md for /app paths.

# --- Paths (local defaults) ---
EXCEL_FILE=data.xlsx
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db_v2
CONVERSATION_DB_URL=sqlite:///./storage/conversations.db

# Docker / EasyPanel (uncomment and use /app paths in containers):
# EXCEL_FILE=/app/data.xlsx
# CHROMA_PERSIST_DIRECTORY=/app/storage/chroma_db_v2
# CONVERSATION_DB_URL=sqlite:////app/storage/conversations.db
# CONVERSATION_DB_URL=postgresql+psycopg2://USER:PASSWORD@postgres:5432/DATABASE
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# --- Server (Docker / production) ---
# PORT=8000

# --- Retrieval ---
# Both vector (Chroma) and Neo4j engines initialize at startup.
# Chat mode (vector / neo4j / hybrid / direct / compare) is selected in the UI.
RAG_TOP_K=5

# Neo4j — required for neo4j and hybrid modes
# Password must match your install (not necessarily "password").
# Test: python -m setup.neo4j.test_connection
# Load graph: python -m setup.neo4j.load_graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Hybrid routing (response_mode=hybrid)
HYBRID_ROUTE_MARGIN=0.15
HYBRID_TOP_K=3

# --- LLM ---
# Default backend at startup; per-message model is chosen in the chat UI.
# Stakeholder simulation requires a real LLM: Ollama locally and/or API keys in ⚙️ API Configuration.
# ollama | openai | anthropic
LLM_BACKEND=ollama
LLM_MODEL=llama3.2
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=280
OLLAMA_TOP_P=0.9
# OLLAMA_HOST=http://localhost:11434

# Provider API keys are stored per-user in the database (Settings UI), not in this file.

# --- Hugging Face Hub (embedding model downloads) ---
# Read token at https://huggingface.co/settings/tokens — avoids unauthenticated rate limits.
HF_TOKEN=

# --- Secrets encryption (user API keys at rest) ---
# Required in production. Generate once and keep stable (re-keying invalidates stored keys).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEY=

# --- Behavior tweaks (optional feedback loop) ---
TWEAK_MODE_ENABLED=false
BEHAVIOR_TWEAKS_FILE=config/behavior/behavior_tweaks.json

# --- Eval script only (setup/eval/run_requirements_chat.py) ---
# EVAL_BASE_URL=http://127.0.0.1:8000
# EVAL_USER=snick
# EVAL_PASSWORD=badPassword1
