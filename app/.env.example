# Stakeholder Simulator — environment template
#
# Local dev:
#   cp app/.env.example app/.env
#
# The app loads app/.env first, then project-root .env (first file wins per key).
# Docker / EasyPanel: set variables in compose or the panel — do not commit .env.
#   See docs/DEPLOY_EASYPANEL.md and docs/OPS_LOCKDOWN.md.

# --- Paths (local defaults) ---
EXCEL_FILE=data.xlsx
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db_v2
SCENARIOS_ROOT=./scenarios
CONVERSATION_DB_URL=sqlite:///./storage/conversations.db

# Docker / EasyPanel (uncomment and use /app paths in containers):
# EXCEL_FILE=/app/data.xlsx
# CHROMA_PERSIST_DIRECTORY=/app/storage/chroma_db_v2
# SCENARIOS_ROOT=/app/scenarios
# CONVERSATION_DB_URL=sqlite:////app/storage/conversations.db
# CONVERSATION_DB_URL=postgresql+psycopg2://USER:PASSWORD@postgres:5432/DATABASE
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# --- Environment / security ---
# ENVIRONMENT=production
# REQUIRE_SECRETS_ENCRYPTION_KEY=1
# REFUSE_DEFAULT_PASSWORDS=1
# Dev-only: seed nick/wayne/claudine/snick with known passwords (NEVER in prod)
# ALLOW_DEFAULT_SEED_USERS=1
# ALLOW_INSECURE_SECRETS=1
# ALLOW_PLAINTEXT_API_KEYS=1
SESSION_TTL_HOURS=12
# CORS_ALLOW_ORIGINS=https://your-host.example,http://localhost:8000
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_HOUR=30

# YAML scenario persona replies: heuristic (default) or openai
# SCENARIO_LLM_PROVIDER=heuristic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Server (Docker / production) ---
# PORT=8000

# --- Retrieval ---
# chromadb|vector = Chroma only; neo4j = graph only; hybrid|compare = both (needed for Neo4j mode in UI)
RAG_BACKEND=hybrid
RAG_TOP_K=5

# Neo4j — required for neo4j and hybrid modes
# Use a strong password; never leave the install default on a networked host.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Hybrid routing (response_mode=hybrid)
HYBRID_ROUTE_MARGIN=0.15
HYBRID_TOP_K=3

# --- LLM ---
LLM_BACKEND=ollama
LLM_MODEL=llama3.2
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=280
OLLAMA_TOP_P=0.9
# OLLAMA_HOST=http://localhost:11434

# --- Hugging Face Hub (embedding model downloads) ---
HF_TOKEN=

# --- Secrets encryption (user API keys at rest) ---
# Required when ENVIRONMENT=production or REQUIRE_SECRETS_ENCRYPTION_KEY=1.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEY=

# --- User token quotas ---
USER_TOKEN_LIMIT=15000

# --- Behavior tweaks (optional feedback loop) ---
TWEAK_MODE_ENABLED=false
BEHAVIOR_TWEAKS_FILE=config/behavior/behavior_tweaks.json

# --- GitHub repo ingest (exit interviews) ---
# Prefer unset for public-only student ingest. If set, keep scope minimal.
# GITHUB_TOKEN=
# Comma-separated org/user allowlist (optional). Empty = any public owner when PUBLIC_ONLY=1.
# GITHUB_ALLOWED_ORGS=
# When 1 (default), private repos are rejected even if the token can read them.
GITHUB_PUBLIC_ONLY=1

# --- Eval script only (setup/eval/run_requirements_chat.py) ---
# EVAL_BASE_URL=http://127.0.0.1:8000
# EVAL_USER=snick
# EVAL_PASSWORD=

# --- Exit interview: LiveKit (optional; text answers work without these) ---
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# STORAGE_RECORDINGS_DIR=./storage/recordings
VOICE_TOKEN_TTL_MINUTES=30
VOICE_UPLOAD_MAX_BYTES=209715200
# VOICE_EXTERNAL_FALLBACK_URL=https://meet.jit.si/sellm-fallback
# RECORDINGS_S3_BUCKET=
# RECORDINGS_S3_ACCESS_KEY=
# RECORDINGS_S3_SECRET_KEY=
# RECORDINGS_S3_REGION=
# RECORDINGS_S3_ENDPOINT=
