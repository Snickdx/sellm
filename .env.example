# Copy to app/.env (local dev) or set these in EasyPanel → Environment (production).
# Canonical template: app/.env.example

# --- Docker / EasyPanel paths (container WORKDIR is /app) ---
EXCEL_FILE=/app/data.xlsx
CHROMA_PERSIST_DIRECTORY=/app/storage/chroma_db_v2
CONVERSATION_DB_URL=sqlite:////app/storage/conversations.db
# CONVERSATION_DB_URL=postgresql+psycopg2://USER:PASSWORD@postgres:5432/DATABASE
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@postgres:5432/DATABASE

RAG_BACKEND=chromadb
LLM_BACKEND=openai
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

RAG_TOP_K=5
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=280
TWEAK_MODE_ENABLED=false
BEHAVIOR_TWEAKS_FILE=config/behavior/behavior_tweaks.json

# Neo4j (optional; set RAG_BACKEND=neo4j or use hybrid chat mode)
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Hybrid routing — see app/.env.example for details
# HYBRID_ROUTE_MARGIN=0.15
# HYBRID_ROUTE_MARGIN=0.15
# HYBRID_NEO4J_TOP_K=3
# HYBRID_CHROMA_TOP_K=3
